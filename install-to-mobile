#!/usr/bin/env bash
#
# Install this repo's mobile apps onto a phone, without opening Xcode.
#
#   ./install-to-mobile               every Flutter app (currently just jikido)
#   ./install-to-mobile jikido        just that one
#   ./install-to-mobile --debug       debug build, for attaching a debugger
#
# Which phone and which Apple team are personal, so they live outside the
# repo, under the XDG config directory like everything else here:
#
#   ~/.config/skagedal-tools/install-to-mobile/devices.env
#
# Symlink your own from wherever you keep such things. Running without it
# prints the file to write.
#
# Flutter's own install step fails with a generic "Try launching Xcode"
# where devicectl succeeds, so building and installing are separate steps.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=shared.sh
source "$SCRIPT_DIR/shared.sh"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/skagedal-tools/install-to-mobile"
CONFIG_FILE="$CONFIG_DIR/devices.env"

usage() {
    echo "Usage: $0 [--debug|--release] [app ...]" >&2
    echo "Apps: ${FLUTTER_TOOLS[*]}" >&2
}

die() {
    echo "install-to-mobile: $*" >&2
    exit 1
}

require-command() {
    command -v "$1" >/dev/null 2>&1 || die "$1 not found on PATH. $2"
}

is-flutter-app() {
    local candidate="$1"
    for app in "${FLUTTER_TOOLS[@]}"; do
        [[ "$app" == "$candidate" ]] && return 0
    done
    return 1
}

parse-args() {
    MODE="release"
    REQUESTED_APPS=()
    for arg in "$@"; do
        case "$arg" in
            --debug) MODE="debug" ;;
            --release) MODE="release" ;;
            -h | --help)
                usage
                exit 0
                ;;
            -*)
                echo "Unknown argument: $arg" >&2
                usage
                exit 1
                ;;
            *)
                is-flutter-app "$arg" || die "not a mobile app in this repo: $arg
Apps: ${FLUTTER_TOOLS[*]}"
                REQUESTED_APPS+=("$arg")
                ;;
        esac
    done
    if [[ ${#REQUESTED_APPS[@]} -eq 0 ]]; then
        REQUESTED_APPS=("${FLUTTER_TOOLS[@]}")
    fi
}

# The device and team are read from the config file rather than kept in the
# repo: this repository is public, and neither value belongs to anyone but
# whoever is running this.
read-config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        cat >&2 <<EOF
install-to-mobile: no config at
  $CONFIG_FILE

Write it, or symlink your own over it, with these two lines:

  # The id \`xcrun devicectl list devices\` prints for your phone.
  IOS_DEVICE=00000000-000000000000000A
  # Your Apple team id: the OU field of the signing certificate, not the
  # value in brackets in \`security find-identity -v -p codesigning\`:
  #   security find-certificate -c "Apple Development: you@example.com" -p \\
  #     | openssl x509 -noout -subject | tr ',' '\\n' | sed -n 's/.*OU *= *//p'
  IOS_TEAM=AAAAAAAAAA
EOF
        exit 1
    fi

    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
    : "${IOS_DEVICE:?not set in $CONFIG_FILE}"
    : "${IOS_TEAM:?not set in $CONFIG_FILE}"
}

# Automatic signing needs to be told the team, and the xcconfig is the only
# place it is written. Regenerated every run so it cannot drift from the
# config, and gitignored so it never lands in a commit. Debug.xcconfig and
# Release.xcconfig include it with `#include?`, so a simulator build — which
# needs no team — still works when it is absent.
write-signing-xcconfig() {
    local dir="$1"
    cat > "$SCRIPT_DIR/$dir/ios/Flutter/Signing.xcconfig" <<EOF
// Generated by install-to-mobile. Edit $CONFIG_FILE instead.
DEVELOPMENT_TEAM = $IOS_TEAM
EOF
}

install-to-phone() {
    local dir="$1"
    echo "==> Installing $dir on $IOS_DEVICE ($MODE)"
    write-signing-xcconfig "$dir"
    (
        cd "$SCRIPT_DIR/$dir"
        run-flutter build ios "--$MODE"
        local app="build/ios/iphoneos/Runner.app"
        [[ -d "$app" ]] || die "the build finished but produced no $dir/$app"
        xcrun devicectl device install app --device "$IOS_DEVICE" "$app"
    )
}

main() {
    parse-args "$@"
    require-command xcrun "Install the Xcode command line tools: xcode-select --install."
    read-config
    for app in "${REQUESTED_APPS[@]}"; do
        install-to-phone "$app"
    done
}

main "$@"
