// NOT IN USE — kept deliberately, to be restored once the repo's package.json5
// convention works again. See the header comment below for what this package is.
//
// pnpm 12 dropped package.json5 support: `pnpm install` / `pnpm run` in this
// directory fail with ERR_PNPM_NO_IMPORTER_MANIFEST_FOUND. Vite never read it
// either, so with no package.json present `vite build web` hung rather than
// failing — a build that sat at 0% CPU indefinitely instead of erroring.
//
// The working manifest is package.json next to this file. Keep the two in sync
// until this is resolved properly across the repo (AGENTS.md still documents
// package.json5 as the convention).

// Manifest for log-viewer (browser-only dev server).
//
// This package now exists primarily as the React app that the Rust
// `log-viewer` binary embeds in its `--web` mode. The Node CLI is kept
// for working on the React app with Vite hot-reload — `pnpm dev` runs
// it. It's no longer installed globally; the user-facing `log-viewer`
// binary is the Rust one (../).
{
  name: "log-viewer",
  version: "1.0.0",
  description: "React browser app for log-viewer (served via Vite or embedded by the Rust binary)",
  type: "module",
  main: "dist/index.js",
  bin: {
    "log-viewer": "dist/index.js"
  },
  scripts: {
    "build": "tsc",
    // Build the React app to web/dist/. The Rust crate's build.rs
    // invokes this on `cargo build --features web` so the binary
    // always embeds an up-to-date dist.
    "build:web": "vite build web",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit && pnpm test && pnpm lint"
  },
  dependencies: {
    "@tanstack/react-table": "latest",
    "@tanstack/react-virtual": "latest",
    "@vitejs/plugin-react": "latest",
    "gunshi": "latest",
    "json5": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  devDependencies: {
    // Pinned to ^9: eslint-plugin-react does not yet support eslint v10.
    // See https://github.com/jsx-eslint/eslint-plugin-react/issues/3977
    "@eslint/js": "^9",
    "eslint": "^9",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint-plugin-react": "latest",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  },
  packageManager: "pnpm@10.33.0"
}
