{
  "name": "log-viewer",
  "version": "1.0.0",
  "description": "React browser app for log-viewer (served via Vite or embedded by the Rust binary)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "log-viewer": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:web": "vite build web",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit && pnpm test && pnpm lint"
  },
  "dependencies": {
    "@tanstack/react-table": "latest",
    "@tanstack/react-virtual": "latest",
    "@vitejs/plugin-react": "latest",
    "gunshi": "latest",
    "json5": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint-plugin-react": "latest",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  },
  "packageManager": "pnpm@10.33.0"
}
