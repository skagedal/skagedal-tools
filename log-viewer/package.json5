// Manifest for log-viewer
{
  name: "log-viewer",
  version: "1.0.0",
  description: "View JSONL logs in a TUI or browser, with vi-like navigation and drill-down",
  type: "module",
  main: "dist/index.mjs",
  bin: {
    "log-viewer": "dist/index.mjs"
  },
  scripts: {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.mjs",
    "dev": "tsx src/index.mts",
    "lint": "eslint .",
    "test": "tsx --test test/*.test.mts",
    "check": "tsc --noEmit && pnpm test && pnpm lint"
  },
  dependencies: {
    "@tanstack/react-table": "latest",
    "@tanstack/react-virtual": "latest",
    "@vitejs/plugin-react": "latest",
    "clipboardy": "latest",
    "gunshi": "latest",
    "ink": "latest",
    "json5": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  devDependencies: {
    // Pinned to ^9: eslint-plugin-react does not yet support eslint v10.
    // See https://github.com/jsx-eslint/eslint-plugin-react/issues/3977
    "@eslint/js": "^9",
    "eslint": "^9",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint-plugin-react": "latest",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  },
  packageManager: "pnpm@10.33.0"
}
