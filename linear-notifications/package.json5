// Manifest for linear-notifications
{
  name: "linear-notifications",
  version: "1.0.0",
  description: "Interactive CLI for viewing unread Linear notifications",
  main: "dist/index.js",
  bin: {
    "linear-notifications": "dist/index.js"
  },
  scripts: {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit && pnpm test"
  },
  devDependencies: {
    "@types/node": "latest",
    "@types/terminal-kit": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  packageManager: "pnpm@10.33.0",
  dependencies: {
    "terminal-kit": "latest"
  }
}
