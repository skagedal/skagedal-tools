#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=shared.sh
source "$SCRIPT_DIR/shared.sh"

main() {
    update-rust-workspace
    for tool in "${NODE_TOOLS[@]}"; do
        update-node "$tool"
    done
    for tool in "${MAVEN_TOOLS[@]}"; do
        update-maven "$tool"
    done
    for tool in "${SWIFT_TOOLS[@]}"; do
        update-swift "$tool"
    done
    for tool in "${FLUTTER_TOOLS[@]}"; do
        update-flutter "$tool"
    done
    update-actions
    echo "==> Dependency changes"
    show-dependency-changes
    echo "==> Done"
}

# pinact rewrites every `uses:` in .github/workflows to the commit SHA its
# tag points at, keeping the version in a trailing comment, and honours the
# three-day min_age in .pinact.yaml. Exit 1 means it found something to pin
# and 2 that something needs a person to decide; neither is a reason to stop
# the rest of the run.
#
# Unauthenticated GitHub API calls are capped at 60 an hour, which one run
# can get through, so lend it the gh token when there is one.
update-actions() {
    echo "==> Updating GitHub Actions"
    if [[ -z "${PINACT_GITHUB_TOKEN:-}" && -z "${GITHUB_TOKEN:-}" ]] &&
        command -v gh >/dev/null 2>&1; then
        PINACT_GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
        [[ -n "$PINACT_GITHUB_TOKEN" ]] && export PINACT_GITHUB_TOKEN
    fi
    (cd "$SCRIPT_DIR" && pinact run --update) ||
        echo "    pinact exited $?, see above"
}

# Capture git-pkgs output sequentially, then feed it into the formatter only
# if we got JSON. Avoids two failure modes:
#   * Piping directly runs both processes concurrently, so a `git pkgs diff`
#     failure surfaces alongside a confusing JSON-parse error from the
#     formatter (pipefail acts on exit status, not on stderr ordering).
#   * `git pkgs diff` doesn't currently resolve refs in git worktrees and
#     also prints "No dependency changes." as plain text even with
#     --format=json, so neither case should reach the formatter.
#
# Once https://github.com/git-pkgs/git-pkgs/pull/194 lands, the worktree
# branch of this can be dropped and we can go back to a simple pipe.
show-dependency-changes() {
    cd "$SCRIPT_DIR"
    local diff_json
    if ! diff_json="$(git pkgs diff --format=json 2>&1)"; then
        echo "(git pkgs diff failed — skipping)"
        printf '%s\n' "$diff_json" | sed 's/^/  /'
        return 0
    fi
    if [[ "$diff_json" == "{"* ]]; then
        printf '%s\n' "$diff_json" | simons-misc-helpers format-dependency-changes
    else
        printf '%s\n' "$diff_json"
    fi
}

main "$@"
