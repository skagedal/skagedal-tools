// Manifest for comparison-typescript-cli-arguments
{
  name: "comparison-typescript-cli-arguments",
  version: "1.0.0",
  description: "Comparison of CLI argument parsing libraries for Node.js/TypeScript",
  type: "module",
  scripts: {
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit && pnpm test",
    "commander": "tsx src/commander.ts",
    "yargs": "tsx src/yargs.ts",
    "meow": "tsx src/meow.mts",
    "citty": "tsx src/citty.ts",
    "gunshi": "tsx src/gunshi.mts"
  },
  dependencies: {
    "@gunshi/plugin-completion": "latest",
    "citty": "latest",
    "commander": "latest",
    "gunshi": "latest",
    "meow": "latest",
    "yargs": "latest"
  },
  devDependencies: {
    "@types/node": "latest",
    "@types/yargs": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  pnpm: {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
