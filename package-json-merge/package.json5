// Manifest for package-json-merge
{
  name: "package-json-merge",
  version: "0.1.0",
  description: "Git merge driver for package.json that picks the higher semver range when both branches bumped the same dependency",
  type: "module",
  main: "dist/index.mjs",
  bin: {
    "package-json-merge": "dist/index.mjs"
  },
  scripts: {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.mjs",
    "dev": "tsx src/index.mts",
    "test": "tsx --test test/*.test.mts",
    "check": "tsc --noEmit && pnpm test"
  },
  dependencies: {
    "gunshi": "latest",
    "semver": "latest"
  },
  devDependencies: {
    "@types/node": "latest",
    "@types/semver": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  packageManager: "pnpm@10.33.0"
}
