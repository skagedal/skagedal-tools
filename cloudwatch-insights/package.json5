// Manifest for cloudwatch-insights
{
  name: "cloudwatch-insights",
  version: "1.0.0",
  description: "Download logs from AWS CloudWatch Logs Insights with a flexible time-range syntax",
  type: "module",
  main: "dist/index.js",
  bin: {
    "cloudwatch-insights": "dist/index.js"
  },
  scripts: {
    "build": "json5 -c package.json5 && tsc",
    "prepare": "json5 -c package.json5 && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts"
  },
  dependencies: {
    "@aws-sdk/client-cloudwatch-logs": "^3.1035.0",
    "chrono-node": "^2.9.0",
    "gunshi": "^0.29.4",
    "smol-toml": "^1.6.1",
    "yaml": "^2.8.3"
  },
  devDependencies: {
    "@types/node": "^22.19.17",
    "json5": "^2.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  packageManager: "pnpm@10.33.0"
}
