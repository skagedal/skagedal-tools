// Manifest for cloudwatch-insights
{
  name: "cloudwatch-insights",
  version: "1.0.0",
  description: "Download logs from AWS CloudWatch Logs Insights with a flexible time-range syntax",
  type: "module",
  main: "dist/index.js",
  bin: {
    "cloudwatch-insights": "dist/index.js"
  },
  scripts: {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit && pnpm test"
  },
  dependencies: {
    "@aws-sdk/client-cloudwatch-logs": "latest",
    "chrono-node": "latest",
    "gunshi": "latest",
    "smol-toml": "latest"
  },
  devDependencies: {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  packageManager: "pnpm@10.33.0"
}
