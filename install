#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=shared.sh
source "$SCRIPT_DIR/shared.sh"

INSTALL_NODE_TOOLS=(linear-notifications cloudwatch-insights log-viewer)
INSTALL_RUST_TOOLS=(git-dirty-checker log-jsonify gh-pr x-java-home)

usage() {
    echo "Usage: $0 [--no-check] [tool ...]" >&2
}

parse-args() {
    CHECK=1
    REQUESTED_TOOLS=()
    for arg in "$@"; do
        case "$arg" in
            --no-check)
                CHECK=0
                ;;
            -*)
                echo "Unknown argument: $arg" >&2
                usage
                exit 1
                ;;
            *)
                REQUESTED_TOOLS+=("$arg")
                ;;
        esac
    done
}

tool-kind() {
    local tool="$1"
    for t in "${INSTALL_NODE_TOOLS[@]}"; do
        if [[ "$t" == "$tool" ]]; then
            echo "node"
            return 0
        fi
    done
    for t in "${INSTALL_RUST_TOOLS[@]}"; do
        if [[ "$t" == "$tool" ]]; then
            echo "rust"
            return 0
        fi
    done
    return 1
}

select-tools() {
    SELECTED_NODE_TOOLS=()
    SELECTED_RUST_TOOLS=()
    if [[ ${#REQUESTED_TOOLS[@]} -eq 0 ]]; then
        SELECTED_NODE_TOOLS=("${INSTALL_NODE_TOOLS[@]}")
        SELECTED_RUST_TOOLS=("${INSTALL_RUST_TOOLS[@]}")
        return
    fi
    for tool in "${REQUESTED_TOOLS[@]}"; do
        local kind
        kind="$(tool-kind "$tool")" || {
            echo "Unknown tool: $tool" >&2
            echo "Available tools: ${INSTALL_NODE_TOOLS[*]} ${INSTALL_RUST_TOOLS[*]}" >&2
            exit 1
        }
        case "$kind" in
            node) SELECTED_NODE_TOOLS+=("$tool") ;;
            rust) SELECTED_RUST_TOOLS+=("$tool") ;;
        esac
    done
}

run-checks() {
    for tool in ${SELECTED_NODE_TOOLS[@]+"${SELECTED_NODE_TOOLS[@]}"}; do
        check-node "$tool"
    done
    for tool in ${SELECTED_RUST_TOOLS[@]+"${SELECTED_RUST_TOOLS[@]}"}; do
        check-rust "$tool"
    done
}

run-installs() {
    for tool in ${SELECTED_NODE_TOOLS[@]+"${SELECTED_NODE_TOOLS[@]}"}; do
        install-node "$tool"
    done
    for tool in ${SELECTED_RUST_TOOLS[@]+"${SELECTED_RUST_TOOLS[@]}"}; do
        install-rust "$tool"
    done
}

main() {
    parse-args "$@"
    select-tools
    if [[ $CHECK -eq 1 ]]; then
        run-checks
    fi
    run-installs
    echo "==> Done"
}

main "$@"
